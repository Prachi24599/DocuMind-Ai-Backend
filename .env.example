PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Set both Clerk keys on the backend to enable protected routes.
# The secret key is backend-only; never use it in frontend code.
# CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
# CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key

# Cloudflare R2 private object storage (configure all values to enable PDF uploads).
# Create an R2 bucket and an API token with Object Read & Write for that bucket.
# R2_ACCOUNT_ID=replace_with_cloudflare_account_id
# R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
# R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
# R2_BUCKET_NAME=replace_with_private_bucket_name
# MAX_UPLOAD_SIZE_BYTES=10485760

# Optional runtime connection for Prisma. Supply through a local secret store or environment.
# DATABASE_URL=

# Optional Prisma CLI migration connection. Prefer a direct, non-pooled PostgreSQL URL.
# Falls back to DATABASE_URL when omitted.
# DIRECT_URL=