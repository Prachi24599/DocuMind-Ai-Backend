{
  "name": "documind-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for DocuMind AI, a production-oriented AI document assistant.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "prisma generate && tsx src/server.ts",
    "build": "prisma generate && tsc",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migration:baseline": "DATABASE_URL=postgresql://127.0.0.1:1/documind DIRECT_URL=postgresql://127.0.0.1:1/documind prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output prisma/migrations/20261015000000_init/migration.sql && node scripts/append-document-metadata-checks.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.81",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "helmet": "^6.0.1",
    "zod": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  },
  "license": "MIT"
}
