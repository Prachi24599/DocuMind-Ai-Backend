generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum DocumentProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

model Document {
  id                    String                   @id @default(uuid()) @db.Uuid
  ownerId               String                   @db.Uuid
  storageKey            String?                  @db.Text
  filename              String                   @db.Text
  fileSizeBytes         BigInt
  mimeType              String                   @db.VarChar(127)
  pageCount             Int?
  status                DocumentProcessingStatus @default(PENDING)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?                @db.Timestamptz(6)
  owner                 User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  conversationDocuments ConversationDocument[]

  @@unique([ownerId, storageKey])
  @@unique([id, ownerId])
  @@index([ownerId, status, createdAt])
  @@index([ownerId, deletedAt, createdAt])
}

model Conversation {
  id        String                 @id @default(uuid()) @db.Uuid
  ownerId   String                 @db.Uuid
  createdAt DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt DateTime               @updatedAt @db.Timestamptz(6)
  owner     User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  messages  Message[]
  documents ConversationDocument[]

  @@unique([id, ownerId])
  @@index([ownerId, updatedAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  ownerId        String       @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  conversation   Conversation @relation(fields: [conversationId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([ownerId, conversationId, createdAt, id])
}

model ConversationDocument {
  conversationId String       @db.Uuid
  documentId     String       @db.Uuid
  ownerId        String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  conversation   Conversation @relation(fields: [conversationId, ownerId], references: [id, ownerId], onDelete: Cascade)
  document       Document     @relation(fields: [documentId, ownerId], references: [id, ownerId], onDelete: Restrict)

  @@id([conversationId, documentId])
  @@index([ownerId, documentId])
}

model User {
  id            String                 @id @default(uuid()) @db.Uuid
  clerkUserId   String                 @unique @db.Text
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(6)
  documents     Document[]
  conversations Conversation[]
  messages      Message[]
  documentLinks ConversationDocument[]
}
